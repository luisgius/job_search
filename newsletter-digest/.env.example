# Copia este fichero a .env y rellena los cuatro valores.
#   cp .env.example .env
#   set -a && source .env && set +a
#
# .env esta en .gitignore. No lo commitees.

# Tu direccion de Gmail completa.
GMAIL_USER=REEMPLAZAME@gmail.com

# Contrasena de aplicacion de Google (16 caracteres, sin espacios).
# Requiere verificacion en dos pasos activada en la cuenta.
# NO es la contrasena normal de tu cuenta.
GMAIL_APP_PASSWORD=REEMPLAZAME_16_CHARS

# Clave de la API de Anthropic. console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=REEMPLAZAME_sk-ant-...

# Destinatario del digest. Si lo dejas vacio se usa GMAIL_USER.
DIGEST_TO=REEMPLAZAME@gmail.com
