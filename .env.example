# Copy to `.env` (git-ignored), fill in, then: chmod 600 .env
#
# Scheduled runs read THIS file, not your shell profile — launchd and cron
# never source ~/.zshrc, so a key exported there is invisible at 08:00.
# scripts/run_daily.sh sources .env and exports everything below; env always
# wins over config.yaml (config.py ENV_OVERRIDES).
#
# This file is shell: QUOTE any value that contains spaces —
#     JOB_HUNTER_PHONE="+34 600 000 000"
# unquoted, the part after the first space is read as a command.

# The provider key for llm.provider (the validation period uses openrouter).
OPENROUTER_API_KEY=
# Only needed if llm.provider is flipped to anthropic later.
ANTHROPIC_API_KEY=

# Optional: free check from healthchecks.io — the run pings it on start,
# success and failure, so a morning where NOTHING ran becomes an email
# instead of a silence. Leave empty to skip pinging.
HEALTHCHECKS_URL=

# Optional, live auto-apply only: the phone stays out of git history — this
# is the one place it lives (see tests/test_no_secrets.py). Quote it: the
# value has spaces.
JOB_HUNTER_PHONE=""

# Optional: Adzuna, if sources.adzuna is ever enabled.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
