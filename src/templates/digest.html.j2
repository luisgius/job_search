{#
  The daily digest page.

  Rendered by src/digest.py with autoescape=True. Every value here comes from
  build_context() already formatted — this template does no arithmetic, no date
  handling and no truncation, and it never calls a method on a model object.

  NOTHING job-sourced may ever be passed through |safe: titles, descriptions,
  verdicts and error strings are attacker-controllable text from the open
  internet, rendered in a file:// page.

  Self-contained by requirement: inline CSS only, no external stylesheet, no
  font, no script, no CDN. It has to work offline from a local file.
#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if totals.needs_click %} — {{ totals.needs_click }} to click{% endif %}</title>
<style>
:root {
  color-scheme: light dark;
  --bg: #f4f6f9;
  --panel: #ffffff;
  --panel-2: #f8fafc;
  --ink: #14181f;
  --muted: #5b6673;
  --line: #e1e6ed;
  --accent: #1b4dd8;
  --accent-ink: #ffffff;
  --good: #0f7a45;
  --good-bg: #e8f6ee;
  --warn: #9a6100;
  --warn-bg: #fdf3e0;
  --bad: #b3261e;
  --bad-bg: #fdeceb;
  --shadow: 0 1px 2px rgba(16, 24, 40, .06), 0 4px 16px rgba(16, 24, 40, .05);
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0e1116;
    --panel: #161b22;
    --panel-2: #1c222b;
    --ink: #e6ebf2;
    --muted: #97a3b2;
    --line: #262d38;
    --accent: #7ba2ff;
    --accent-ink: #0b1020;
    --good: #56d39a;
    --good-bg: #102b1f;
    --warn: #e5ad5a;
    --warn-bg: #2c2213;
    --bad: #ff8b82;
    --bad-bg: #2e1614;
    --shadow: 0 1px 2px rgba(0, 0, 0, .5);
  }
}
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
}
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Ubuntu, Cantarell, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  -webkit-text-size-adjust: 100%;
}
a {
  color: var(--accent);
}
h1, h2, h3, h4 {
  margin: 0;
  line-height: 1.25;
}
.wrap {
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 20px;
}

/* ---------- sticky header ---------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--panel);
  border-bottom: 1px solid var(--line);
  box-shadow: var(--shadow);
}
.topbar .wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 20px;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  padding-bottom: 12px;
}
.brand h1 {
  font-size: 19px;
  letter-spacing: -.01em;
}
.brand .sub {
  color: var(--muted);
  font-size: 12.5px;
  margin-top: 2px;
}
.counts {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.pill {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  padding: 5px 11px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--panel-2);
  color: var(--muted);
  font-size: 12.5px;
  text-decoration: none;
  white-space: nowrap;
}
.pill b {
  color: var(--ink);
  font-size: 14px;
}
.pill.hot {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--accent-ink);
}
.pill.hot b {
  color: var(--accent-ink);
}

/* ---------- layout ---------- */
main {
  padding: 26px 0 60px;
}
section {
  margin: 0 0 34px;
}
.sec-head {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--line);
}
.sec-head h2 {
  font-size: 17px;
}
.sec-head .n {
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  font-size: 13px;
}
.sec-head .hint {
  color: var(--muted);
  font-size: 12.5px;
  margin-left: auto;
}
.empty {
  color: var(--muted);
  font-size: 13.5px;
  background: var(--panel);
  border: 1px dashed var(--line);
  border-radius: 10px;
  padding: 14px 16px;
  margin: 0;
}
.banner {
  background: var(--panel);
  border: 1px solid var(--line);
  border-left: 4px solid var(--accent);
  border-radius: 10px;
  padding: 16px 18px;
  margin-bottom: 26px;
  box-shadow: var(--shadow);
}
.banner h2 {
  font-size: 16px;
  margin-bottom: 4px;
}
.banner p {
  margin: 0;
  color: var(--muted);
  font-size: 13.5px;
}

/* ---------- cards ---------- */
.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 16px 18px;
  margin-bottom: 14px;
  box-shadow: var(--shadow);
}
.card.good {
  border-left: 4px solid var(--good);
}
.card.warn {
  border-left: 4px solid var(--warn);
}
.card.bad {
  border-left: 4px solid var(--bad);
}
.head {
  display: flex;
  gap: 14px;
  align-items: flex-start;
}
.who {
  min-width: 0;
  flex: 1;
}
.role {
  font-size: 16.5px;
  letter-spacing: -.01em;
  word-break: break-word;
}
.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 10px;
  align-items: center;
  color: var(--muted);
  font-size: 12.5px;
  margin-top: 5px;
}
.tag {
  border: 1px solid var(--line);
  background: var(--panel-2);
  border-radius: 5px;
  padding: 1px 7px;
  font-size: 11.5px;
  letter-spacing: .02em;
}
.tag.src {
  text-transform: lowercase;
}
.badge {
  flex: none;
  min-width: 48px;
  text-align: center;
  padding: 8px 6px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 18px;
  font-variant-numeric: tabular-nums;
  border: 1px solid transparent;
}
.score-90 {
  background: var(--good-bg);
  color: var(--good);
  border-color: var(--good);
}
.score-80 {
  background: rgba(27, 77, 216, .1);
  color: var(--accent);
  border-color: var(--accent);
}
.score-70 {
  background: var(--warn-bg);
  color: var(--warn);
  border-color: var(--warn);
}
.score-low {
  background: var(--panel-2);
  color: var(--muted);
  border-color: var(--line);
}
.score-unscored {
  background: var(--muted-bg, #e8e8ea);
  color: var(--muted-fg, #555);
}
.score-error {
  background: var(--bad-bg);
  color: var(--bad);
  border-color: var(--bad);
}
.verdict {
  margin: 12px 0 0;
  font-size: 14.5px;
}
.alert {
  margin: 10px 0 0;
  padding: 8px 10px;
  border-radius: 8px;
  background: var(--bad-bg);
  color: var(--bad);
  font-size: 13px;
}
.note {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 13px;
}
.note code {
  font-size: 12.5px;
  word-break: break-word;
}

/* ---------- actions ---------- */
.links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  margin-top: 14px;
}
.btn {
  background: var(--accent);
  color: var(--accent-ink);
  text-decoration: none;
  font-weight: 600;
  font-size: 14.5px;
  padding: 9px 16px;
  border-radius: 9px;
  white-space: nowrap;
}
.btn:hover {
  filter: brightness(1.08);
}
.file {
  text-decoration: none;
  color: var(--ink);
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 7px 11px;
  font-size: 13px;
  white-space: nowrap;
}
.file:hover {
  border-color: var(--accent);
  color: var(--accent);
}

/* ---------- reasons ---------- */
.cols {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 6px 22px;
  margin-top: 12px;
}
.cols h4 {
  font-size: 11.5px;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--muted);
  margin-bottom: 3px;
}
.cols ul {
  margin: 0;
  padding-left: 18px;
  font-size: 13.5px;
}
.cols li {
  margin: 2px 0;
}

/* ---------- disclosure blocks ---------- */
details {
  margin-top: 12px;
  border-top: 1px solid var(--line);
  padding-top: 10px;
}
summary {
  cursor: pointer;
  color: var(--muted);
  font-size: 13px;
  user-select: none;
}
summary:hover {
  color: var(--accent);
}
details pre, .excerpt {
  margin: 10px 0 0;
  background: var(--panel-2);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 13px;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}
.excerpt {
  font-family: inherit;
  color: var(--muted);
}

/* ---------- screenshots ---------- */
.shot {
  display: block;
  margin-top: 12px;
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
  background: var(--panel-2);
  max-width: 520px;
}
.shot img {
  display: block;
  width: 100%;
  height: auto;
}

/* ---------- tables ---------- */
.scroll {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--panel);
}
table {
  border-collapse: collapse;
  width: 100%;
  font-size: 13.5px;
}
th, td {
  text-align: left;
  padding: 8px 12px;
  border-bottom: 1px solid var(--line);
  vertical-align: top;
}
th {
  color: var(--muted);
  font-weight: 600;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .05em;
  white-space: nowrap;
}
tr:last-child td {
  border-bottom: none;
}
td.num {
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  white-space: nowrap;
}

/* ---------- stats ---------- */
.funnel {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: stretch;
  margin-bottom: 16px;
}
.step {
  flex: 1 1 130px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 12px 14px;
}
.step .v {
  font-size: 22px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.step .k {
  color: var(--muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .05em;
}
.arrow {
  align-self: center;
  color: var(--muted);
}
.grid2 {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
}
.grid2 h3 {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: .05em;
  color: var(--muted);
  margin-bottom: 8px;
}
pre.errors {
  margin: 0;
  background: var(--bad-bg);
  color: var(--bad);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 12px 14px;
  font-size: 12.5px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

/* ---------- footer ---------- */
footer {
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 12.5px;
  padding: 18px 0 40px;
  background: var(--panel);
}
footer p {
  margin: 4px 0;
}
footer code {
  overflow-wrap: anywhere;
}
.mode-dry {
  color: var(--warn);
  font-weight: 600;
}
.mode-live {
  color: var(--bad);
  font-weight: 600;
}

@media (max-width: 640px) {
  .wrap {
    padding: 0 14px;
  }
  .badge {
    min-width: 42px;
    font-size: 16px;
  }
  .btn {
    width: 100%;
    text-align: center;
  }
}
@media print {
  .topbar {
    position: static;
  }
  body {
    background: #fff;
  }
}
</style>
</head>
<body>

{#
  Advisory ghost-job notes: posting age past freshness.stale_after_days, and a
  re-listing of a role already seen under another job id. Rendered with the
  same `p.alert` line the scorer's own failure uses, deliberately — a second
  warning style would just teach the reader that some warnings are optional.

  These NEVER remove a card. Every sentence is computed in digest._ghost_flags;
  this loop prints what it was given and decides nothing. Defined before
  card_head because that macro calls it.
#}
{% macro ghost_flags(item) %}
{# `or []` because render_html documents that it accepts a hand-built or
   partial context, and iterating a missing key would take the whole page
   down over an advisory line. #}
{% for flag in item.flags or [] %}
<p class="alert">{{ flag }}</p>
{% endfor %}
{% endmacro %}

{% macro card_head(item) %}
<div class="head">
  <span class="badge {{ item.score_class }}" title="fit score{% if item.score_model %} — {{ item.score_model }}{% endif %}">{{ item.score_label }}</span>
  <div class="who">
    <h3 class="role">{{ item.company }} — {{ item.title }}</h3>
    <div class="meta">
      <span>{{ item.location or 'location unstated' }}</span>
      {% if item.country %}<span class="tag">{{ item.country }}</span>{% endif %}
      {% if item.source %}<span class="tag src">{{ item.source }}</span>{% endif %}
      <span>{{ item.posted_label }}</span>
      {% if item.salary %}<span>{{ item.salary }}</span>{% endif %}
    </div>
  </div>
</div>
{{ ghost_flags(item) }}
{% endmacro %}

{% macro links(item, primary) %}
<div class="links">
  {% if item.url %}
  <a class="btn" href="{{ item.url }}" target="_blank" rel="noopener">{{ primary }}</a>
  {% endif %}
  {% if item.cv_md %}<a class="file" href="{{ item.cv_md }}">Tailored CV (md)</a>{% endif %}
  {% if item.cover_md %}<a class="file" href="{{ item.cover_md }}">Cover letter (md)</a>{% endif %}
  {% if item.cv_pdf %}<a class="file" href="{{ item.cv_pdf }}">CV PDF</a>{% endif %}
  {% if item.cover_pdf %}<a class="file" href="{{ item.cover_pdf }}">Cover PDF</a>{% endif %}
  {% if item.artifacts_dir %}<a class="file" href="{{ item.artifacts_dir }}">Files</a>{% endif %}
</div>
{% endmacro %}

{% macro judgment(item) %}
{% if item.verdict %}<p class="verdict">{{ item.verdict }}</p>{% endif %}
{% if item.score_error %}
<p class="alert">Scorer failed: {{ item.score_error }} — this one is unscored, judge it yourself.</p>
{% endif %}
{% if item.reasons or item.strengths or item.gaps %}
<div class="cols">
  {% if item.reasons %}
  <div>
    <h4>Why</h4>
    <ul>{% for reason in item.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  {% if item.strengths %}
  <div>
    <h4>Strengths</h4>
    <ul>{% for strength in item.strengths %}<li>{{ strength }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  {% if item.gaps %}
  <div>
    <h4>Gaps</h4>
    <ul>{% for gap in item.gaps %}<li>{{ gap }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
</div>
{% endif %}
{% endmacro %}

{% macro previews(item) %}
{% if item.cover_preview %}
<details>
  <summary>Cover letter preview</summary>
  <pre>{{ item.cover_preview }}</pre>
</details>
{% endif %}
{% if item.description_excerpt %}
<details>
  <summary>Posting excerpt</summary>
  <p class="excerpt">{{ item.description_excerpt }}</p>
</details>
{% endif %}
{% endmacro %}

<header class="topbar">
  <div class="wrap">
    <div class="brand">
      <h1>Job Hunter{% if applicant.name %} — {{ applicant.name }}{% endif %}</h1>
      <div class="sub">{{ weekday }} {{ date_str }} · generated {{ generated_at_str }}</div>
    </div>
    <div class="counts">
      <a class="pill hot" href="#needs-click"><b>{{ totals.needs_click }}</b> need your click</a>
      <a class="pill" href="#auto-applied"><b>{{ totals.auto_applied }}</b> applied</a>
      <a class="pill" href="#dry-run"><b>{{ totals.dry_run }}</b> dry run</a>
      <a class="pill" href="#failed"><b>{{ totals.failed }}</b> skipped</a>
      <a class="pill" href="#below"><b>{{ totals.below }}</b> below</a>
    </div>
  </div>
</header>

<main class="wrap">

{% if totals.all == 0 %}
<div class="banner">
  <h2>Nothing new today</h2>
  <p>No posting made it through to a decision. Check the funnel at the bottom before assuming
     it was a quiet day — a run that fetched zero jobs looks exactly like one that had nothing
     to show.</p>
</div>
{% endif %}

{# ---------------- 1. needs your click ---------------- #}
<section id="needs-click">
  <div class="sec-head">
    <h2>Needs your click</h2>
    <span class="n">{{ totals.needs_click }}</span>
    <span class="hint">threshold {{ config_summary.threshold }} · sorted by fit</span>
  </div>
  {% if needs_click %}
    {% for item in needs_click %}
    <article class="card">
      {{ card_head(item) }}
      {{ judgment(item) }}
      {{ links(item, 'Open application →') }}
      {% if item.status_detail %}<p class="note">{{ item.status_detail }}</p>{% endif %}
      {{ previews(item) }}
    </article>
    {% endfor %}
  {% else %}
    <p class="empty">Nothing above the threshold today.</p>
  {% endif %}
</section>

{# ---------------- 2. auto-applied ---------------- #}
<section class="sec">
  <h2>⚠️ Submitted — but unconfirmed <span class="count">{{ unconfirmed|length }}</span></h2>
  {% if unconfirmed %}
  <p class="note">The submit click landed and the page could not be read afterwards,
     so it is unknown whether these reached the employer. They are blocked from being
     sent again — <strong>open each one and check by hand.</strong></p>
  {% for item in unconfirmed %}
  <article class="card warn">
    <span class="badge {{ item.score_class }}">{{ item.score_label }}</span>
    <strong>{{ item.company }}</strong> — {{ item.title }}
    <div class="meta">{{ item.location }} · {{ item.posted_label }}</div>
    {{ ghost_flags(item) }}
    <div class="detail">{{ item.status_detail }}</div>
    <a href="{{ item.url }}" target="_blank" rel="noopener">Open the posting →</a>
  </article>
  {% endfor %}
  {% else %}<p class="empty">Nothing unconfirmed. Good.</p>{% endif %}
</section>

<section id="auto-applied">
  <div class="sec-head">
    <h2>Auto-applied</h2>
    <span class="n">{{ totals.auto_applied }}</span>
    <span class="hint">submitted on your behalf — verify in your inbox</span>
  </div>
  {% if auto_applied %}
    {% for item in auto_applied %}
    <article class="card good">
      {{ card_head(item) }}
      <p class="note">Submitted {{ generated_at_str }}{% if item.ats %} · method: {{ item.ats }} form fill{% endif %}{% if item.status_detail %} · {{ item.status_detail }}{% endif %}</p>
      {{ links(item, 'Open posting →') }}
      {% if item.screenshot %}
      <a class="shot" href="{{ item.screenshot }}" target="_blank" rel="noopener">
        <img src="{{ item.screenshot }}" alt="Submitted form for {{ item.company }} — {{ item.title }}" loading="lazy">
      </a>
      {% endif %}
      {{ previews(item) }}
    </article>
    {% endfor %}
  {% else %}
    <p class="empty">Nothing was submitted automatically{% if config_summary.dry_run %} — dry run is on, which is the point{% endif %}.</p>
  {% endif %}
</section>

{# ---------------- 3. dry run ---------------- #}
<section id="dry-run">
  <div class="sec-head">
    <h2>Dry run — check these</h2>
    <span class="n">{{ totals.dry_run }}</span>
    <span class="hint">form filled, nothing submitted — open each screenshot</span>
  </div>
  {% if dry_run %}
    {% for item in dry_run %}
    <article class="card warn">
      {{ card_head(item) }}
      {% if item.status_detail %}<p class="note">{{ item.status_detail }}</p>{% endif %}
      {% if item.screenshot %}
      <a class="shot" href="{{ item.screenshot }}" target="_blank" rel="noopener">
        <img src="{{ item.screenshot }}" alt="Filled application form for {{ item.company }} — {{ item.title }}" loading="lazy">
      </a>
      {% else %}
      <p class="note">No screenshot was saved for this one — treat the fill as unverified.</p>
      {% endif %}
      {{ links(item, 'Open application →') }}
      {{ previews(item) }}
    </article>
    {% endfor %}
  {% else %}
    <p class="empty">No forms were filled this run.</p>
  {% endif %}
</section>

{# ---------------- 4. skipped / failed ---------------- #}
<section id="failed">
  <div class="sec-head">
    <h2>Skipped auto-apply / failed</h2>
    <span class="n">{{ totals.failed }}</span>
    <span class="hint">why it bailed, verbatim — this is the safety net working</span>
  </div>
  {% if failed %}
    {% for item in failed %}
    <article class="card bad">
      {{ card_head(item) }}
      <p class="alert">{{ item.status_detail or 'no reason recorded' }}</p>
      {{ links(item, 'Apply by hand →') }}
      {% if item.screenshot %}
      <a class="shot" href="{{ item.screenshot }}" target="_blank" rel="noopener">
        <img src="{{ item.screenshot }}" alt="Form state for {{ item.company }} — {{ item.title }}" loading="lazy">
      </a>
      {% endif %}
      {{ previews(item) }}
    </article>
    {% endfor %}
  {% else %}
    <p class="empty">Nothing bailed out this run.</p>
  {% endif %}
</section>

{# ---------------- 5. below threshold ---------------- #}
<section id="below">
  <div class="sec-head">
    <h2>Below threshold</h2>
    <span class="n">{{ totals.below }}</span>
    <span class="hint">audit this in week one — if you would have applied, your threshold is too high</span>
  </div>
  {% if below %}
  <details>
    <summary>Show {{ totals.below }} posting{{ '' if totals.below == 1 else 's' }} scored under {{ config_summary.threshold }}</summary>
    <div class="scroll">
      <table>
        <thead>
          <tr><th>Score</th><th>Company</th><th>Title</th><th>Where</th><th>Verdict</th></tr>
        </thead>
        <tbody>
          {% for item in below %}
          <tr>
            <td class="num">{{ item.score_label }}</td>
            <td>{{ item.company }}</td>
            <td>
              {% if item.url %}
              <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
              {% else %}
              {{ item.title }}
              {% endif %}
            </td>
            <td>{{ item.location or '—' }}</td>
            <td>{{ item.verdict or item.status_detail or '—' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
  {% else %}
    <p class="empty">Nothing scored below the threshold.</p>
  {% endif %}
</section>

{# ---------------- other outcomes (only when something lands here) -------- #}
{% if other %}
<section id="other">
  <div class="sec-head">
    <h2>Other outcomes</h2>
    <span class="n">{{ totals.other }}</span>
    <span class="hint">statuses that belong to no section above</span>
  </div>
  <div class="scroll">
    <table>
      <thead>
        <tr><th>Status</th><th>Score</th><th>Company</th><th>Title</th><th>Detail</th></tr>
      </thead>
      <tbody>
        {% for item in other %}
        <tr>
          <td>{{ item.status }}</td>
          <td class="num">{{ item.score_label }}</td>
          <td>{{ item.company }}</td>
          <td>
            {% if item.url %}
            <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
            {% else %}
            {{ item.title }}
            {% endif %}
          </td>
          <td>{{ item.status_detail or '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

{# ---------------- 6. run stats ---------------- #}
<section id="stats">
  <div class="sec-head">
    <h2>Run stats</h2>
    <span class="hint">read the numbers, not just the cards — zero fetched is a broken run, not a quiet day</span>
  </div>

  <div class="funnel">
    {% for step in funnel %}
    <div class="step">
      <div class="v">{{ step.value }}</div>
      <div class="k">{{ step.label }}</div>
    </div>
    {% if not loop.last %}<div class="arrow">→</div>{% endif %}
    {% endfor %}
  </div>

  <div class="grid2">
    <div>
      <h3>Per source</h3>
      <div class="scroll">
        <table>
          <tbody>
            {% if source_counts %}
              {% for name, count in source_counts.items() %}
              <tr><td>{{ name }}</td><td class="num">{{ count }}</td></tr>
              {% endfor %}
            {% else %}
              <tr><td>no source reported a count</td><td class="num">0</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h3>Filter rejections</h3>
      <div class="scroll">
        <table>
          <tbody>
            {% if filter_counts %}
              {% for reason, count in filter_counts.items() %}
              <tr><td>{{ reason }}</td><td class="num">{{ count }}</td></tr>
              {% endfor %}
            {% else %}
              <tr><td>nothing was rejected by the hard filters</td><td class="num">0</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h3>Outcomes</h3>
      <div class="scroll">
        <table>
          <tbody>
            <tr><td>already seen (not re-surfaced)</td><td class="num">{{ stats.already_seen or 0 }}</td></tr>
            <tr><td>tailored</td><td class="num">{{ stats.tailored or 0 }}</td></tr>
            <tr><td>auto-applied</td><td class="num">{{ stats.auto_applied or 0 }}</td></tr>
            <tr><td>dry run</td><td class="num">{{ stats.dry_run or 0 }}</td></tr>
            <tr><td>apply failed</td><td class="num">{{ stats.apply_failed or 0 }}</td></tr>
            <tr><td>in this digest</td><td class="num">{{ totals.all }}</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <h3>Settings this run</h3>
      <div class="scroll">
        <table>
          <tbody>
            <tr><td>score threshold</td><td class="num">{{ config_summary.threshold }}</td></tr>
            <tr><td>auto-apply floor</td><td class="num">{{ config_summary.apply_min_score }}</td></tr>
            <tr><td>max age (hours)</td><td class="num">{{ config_summary.max_age_hours }}</td></tr>
            <tr><td>flag as stale after (days)</td><td class="num">{{ config_summary.stale_after_days }}</td></tr>
            <tr><td>scoring model</td><td>{{ config_summary.scoring_model or '—' }}</td></tr>
            <tr><td>tailoring model</td><td>{{ config_summary.tailoring_model if config_summary.tailoring_enabled else 'off' }}</td></tr>
            <tr><td>sources enabled</td><td>{{ config_summary.sources_enabled | join(', ') or 'none' }}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {% if errors %}
  <h3 style="margin-top:16px">Errors ({{ errors | length }})</h3>
  <pre class="errors">{% for error in errors %}{{ error }}
{% endfor %}</pre>
  {% endif %}
</section>

</main>

<footer>
  <div class="wrap">
    <p>
      Auto-apply:
      {% if not config_summary.apply_enabled %}
        <span class="mode-dry">disabled</span> — every match needs your click.
      {% elif config_summary.dry_run %}
        <span class="mode-dry">dry run</span> — forms are filled and screenshotted, nothing is ever submitted.
      {% else %}
        <span class="mode-live">LIVE</span> — applications at or above {{ config_summary.apply_min_score }} are submitted for real.
      {% endif %}
    </p>
    <p>Tracker database: <code>{{ config_summary.db_path }}</code> — it is the only record that you applied to anything. Back it up.</p>
    <p>Artifacts: <code>{{ config_summary.output_dir }}</code> · this page overwrites itself on a re-run.</p>
  </div>
</footer>

</body>
</html>
